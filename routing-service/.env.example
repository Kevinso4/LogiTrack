# Copia de .env.example de fleet-service (mismos namespaces del stack).
# En producción NUNCA se usan credenciales por defecto; van por secretos.
SERVICIO=routing-service
ENTORNO=local
VERSION=1.0.0

# Persistent
DATABASE_URL=postgresql+asyncpg://logitrack:logitrack@localhost:5432/routing_db

# Bus de eventos
BUS_HABILITADO=true
RABBITMQ_URL=amqp://logitrack:logitrack@localhost:5672/
EXCHANGE_EVENTOS=logitrack.events
COLA_CONSUMIDOR=routing.inbox
OUTBOX_INTERVALO_SEGUNDOS=1
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=10

# Cliente de Fleet (REST síncrono)
FLEET_URL=http://localhost:8001
FLEET_TIMEOUT_SEGUNDOS=3
FLEET_MAX_REINTENTOS=2
CIRCUITO_ERRORES_ANTES_DE_ABRIR=3
CIRCUITO_RESET_SEGUNDOS=30
# Dialecto de Fleet: "propio" o "companero" (capa anticorrupción)
FLEET_DIALECTO=propio

# Proveedor de mapas: "simulado" (sin token) o "mapbox"
PROVEEDOR_MAPAS=simulado
MAPBOX_TOKEN=
MAPBOX_URL_BASE=https://api.mapbox.com

# Caché de ETAs (opcional)
REDIS_HABILITADO=true
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_ETA_SEGUNDOS=300

# Reglas de ruta
VELOCIDAD_ESTIMACION_KMH=40
FACTOR_ROTERO=1.3
LIMITE_CONDUCCION_MIN=270
PAUSA_DESCANSO_MIN=45
UMBRAL_DESVIO_MIN=15

# Observabilidad
LOG_LEVEL=INFO