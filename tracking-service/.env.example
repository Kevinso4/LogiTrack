# Tracking Ingestion Service — copiar a .env para correr en local sin Docker
DATABASE_URL=postgresql+asyncpg://logitrack:logitrack@localhost:5432/tracking_db
RABBITMQ_URL=amqp://logitrack:logitrack@localhost:5672/
EXCHANGE_EVENTOS=logitrack.events
BUS_HABILITADO=true
ENTORNO=local
LOG_LEVEL=INFO
CHUNK_DIAS=7
VENTANA_AGREGACION_SEGUNDOS=60
MAX_LECTURAS_POR_LOTE=5000
VELOCIDAD_MAXIMA_KMH=200
# Lista JSON de API keys de los dispositivos. En local vacía = endpoint abierto
# a propósito; en Docker el compose define una clave (X-API-Key) y el servicio
# exige claves si ENTORNO no es de desarrollo (no arranca desplegado abierto).
API_KEYS=[]
