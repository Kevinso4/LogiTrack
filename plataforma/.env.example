# Variables de ejecución de los microservicios (en Render se definen por servicio).
# En desarrollo local docker-compose.yml ya las define; este archivo es la referencia.
DATABASE_URL=postgresql+psycopg://logitrack:logitrack@postgres:5432/<servicio>_db
RABBITMQ_URL=amqp://logitrack:logitrack@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
# Gateway: clave privada RSA (PEM) para firmar JWT RS256. Si falta, se genera una efímera.
JWT_PRIVATE_KEY=
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
