# Copia de .env.example del resto del stack.
# En producción NUNCA se usan credenciales por defecto; van por secretos.
SERVICIO=shipment-service
ENTORNO=local
VERSION=1.0.0

# Persistent
DATABASE_URL=postgresql+asyncpg://logitrack:logitrack@localhost:5432/shipment_db

# Bus de eventos
BUS_HABILITADO=true
RABBITMQ_URL=amqp://logitrack:logitrack@localhost:5672/
EXCHANGE_EVENTOS=logitrack.events
COLA_CONSUMIDOR=shipment.inbox
OUTBOX_INTERVALO_SEGUNDOS=1
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=10

# Reglas de estado del envío
MARGEN_SLA_MIN=15

# Observabilidad
LOG_LEVEL=INFO