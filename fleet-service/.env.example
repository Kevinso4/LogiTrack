# Fleet Service — copiar a .env para correr en local sin Docker
DATABASE_URL=postgresql+asyncpg://logitrack:logitrack@localhost:5432/fleet_db
RABBITMQ_URL=amqp://logitrack:logitrack@localhost:5672/
EXCHANGE_EVENTOS=logitrack.events
COLA_CONSUMIDOR=fleet.inbox
BUS_HABILITADO=true
ENTORNO=local
LOG_LEVEL=INFO
HORAS_MAX_CONDUCCION_SEMANA=56
